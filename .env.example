# Copia este archivo como .env y ajusta los valores.
# .env está ignorado por Git; .env.example sí se puede versionar.

# PostgreSQL (Docker)
POSTGRES_DB=reservas
POSTGRES_USER=reservas
POSTGRES_PASSWORD=cambia-esta-contraseña

# API
JWT_KEY=cambia-esta-clave-por-una-de-al-menos-32-caracteres
BOOTSTRAP_ADMIN_EMAIL=admin@reservas.local
BOOTSTRAP_ADMIN_PASSWORD=cambia-esta-contraseña

# Gmail: solo necesitas el correo y la contraseña de aplicación.
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-contraseña-de-aplicación

# Opcionales. Para Gmail no hacen falta.
# SMTP_FROM_NAME=Reservas
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=tu-correo@gmail.com
# SMTP_ENABLE_SSL=true

# Opcionales de la landing pública
# BUSINESS_NAME=Reservas
# PUBLIC_BOOKING_PEPPER=una-cadena-larga-y-aleatoria
# RECORDATORIO_HORAS_ANTES=24
# RECORDATORIO_INTERVALO_MINUTOS=15
